#!/usr/bin/env python3
from __future__ import annotations
import os, sys
from pathlib import Path
import yaml

config = Path(os.environ.get("TP_SPEC_INSTALLATION_CONFIG") or (Path.home() / ".tp-spec" / "installation.yaml"))
if not config.is_file():
    print(f"[tp-spec] installation config missing: {config}", file=sys.stderr); raise SystemExit(2)
try:
    data = yaml.safe_load(config.read_text(encoding="utf-8-sig")) or {}
    base = Path(str((data.get("base") or {}).get("root") or "")).expanduser()
except Exception as exc:
    print(f"[tp-spec] invalid installation config: {exc}", file=sys.stderr); raise SystemExit(2)
main = base / "cli" / "main.py"
if not main.is_file():
    print(f"[tp-spec] invalid Base root: {base}", file=sys.stderr); raise SystemExit(2)
os.execv(sys.executable, [sys.executable, str(main), *sys.argv[1:]])
