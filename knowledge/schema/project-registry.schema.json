{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tp-spec.local/knowledge/schema/project-registry.schema.json",
  "title": "Knowledge Project Registry",
  "type": "object",
  "required": [
    "registry_version",
    "projects"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "source_dir": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "dormant",
              "archived"
            ]
          },
          "workspace_roots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "shared_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
